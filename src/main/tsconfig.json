{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "../../dist/main",
    "rootDir": "..",                // <-- changed from "." to ".."
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": [
    "**/*.ts",                   // all .ts files in src/main
    "../shared/**/*.ts"          // also include shared types
  ]
}